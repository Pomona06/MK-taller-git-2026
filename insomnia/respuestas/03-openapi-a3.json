:"Cargador vacío (MUNICION_AGOTADA)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"},"example":{"status":409,"codigo":"MUNICION_AGOTADA","excepcion":"MunicionAgotadaException","mensaje":"AK-47 tiene el cargador vacío (reserva: 90): hay que recargar antes de disparar"}}}},"400":{"description":"Falta municionCargador, es negativa o el modo no existe (VALOR_ILEGAL / JSON_INVALIDO)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}}}},"/api/reglas/danio":{"post":{"tags":["Reglas"],"summary":"Regla 2 · daño con blindaje","description":"Solo se le dispara a un enemigo vivo (otro equipo, vida mayor a 0). El blindaje absorbe hasta la mitad del daño y el resto baja la vida, que nunca queda por debajo de 0. Con vida 0 el objetivo queda eliminado.","operationId":"danio","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConsultaDeDanio"}}},"required":true},"responses":{"200":{"description":"Objetivo válido: devuelve cómo queda","content":{"*/*":{"example":{"regla":"DANIO","permitido":true,"resultado":{"absorbidoPorBlindaje":90,"danioALaVida":90,"vidaFinal":10,"blindajeFinal":10,"eliminado":false}}}}},"422":{"description":"Fuego amigo u objetivo ya eliminado (DISPARO_NO_PERMITIDO)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"},"example":{"status":422,"codigo":"DISPARO_NO_PERMITIDO","excepcion":"DisparoNoPermitidoException","mensaje":"Fuego amigo: Sombra y Cuervo son del mismo equipo (TERRORISTAS)"}}}},"400":{"description":"Faltan campos, equipo desconocido o vida/blindaje fuera de 0 a 100","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorRespuesta"}}}}}}},"/api/jugadores":{"get":{"tags":["Jugadores"],"operationId":"listar","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Jugador"}}}}}}},"post":{"tags":["Jugadores"],"summary":"Crear un jugador","description":"blindaje (0 a 100), dine